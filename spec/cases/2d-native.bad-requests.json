{
 "schema": "poulsback-case-list-v1",
 "family": "2d-native.bad-requests",
 "source": "Every SUBMIT_2D validation in kernel/engine/poulsback_submit.c and poulsback_twod.c at driver HEAD, one case per condition",
 "criteria": "The ioctl returns the named errno, the BOs keep their bytes and the engine counts no 2D job (no publication).",
 "runner": null,
 "external": null,
 "cases": [
  {
   "id": "submit-2d/args-bad-pointer",
   "parameters": {
    "errno": "EFAULT",
    "condition": "the ioctl argument does not point at a readable (in) or writable (out) struct poulsback_submit_2d",
    "where": "linux-6.1 drivers/gpu/drm/drm_ioctl.c:drm_ioctl (copy_from_user / copy_to_user)",
    "note": "DRM layer, before and after the handler. A readable but read-only struct fails only on the copy back, after the handler's side effect."
   }
  },
  {
   "id": "submit-2d/device-unplugged",
   "parameters": {
    "errno": "ENODEV",
    "condition": "the device was unplugged (drm_dev_is_unplugged)",
    "where": "linux-6.1 drivers/gpu/drm/drm_ioctl.c:drm_ioctl (drm_dev_is_unplugged)",
    "note": "psb_pci_remove calls drm_dev_unplug (linux.patch). A caller with the fd open needs root to provoke it (sysfs PCI remove)."
   }
  },
  {
   "id": "submit-2d/abi-unknown",
   "parameters": {
    "errno": "EINVAL",
    "condition": "args->abi != POULSBACK_EXEC_ABI",
    "where": "kernel/engine/poulsback_submit.c:poulsback_submit_2d_ioctl"
   }
  },
  {
   "id": "submit-2d/flags-nonzero",
   "parameters": {
    "errno": "EINVAL",
    "condition": "args->flags != 0",
    "where": "kernel/engine/poulsback_submit.c:poulsback_submit_2d_ioctl"
   }
  },
  {
   "id": "submit-2d/context-zero",
   "parameters": {
    "errno": "EINVAL",
    "condition": "args->context == 0",
    "where": "kernel/engine/poulsback_submit.c:poulsback_submit_2d_ioctl"
   }
  },
  {
   "id": "submit-2d/bo-count-zero",
   "parameters": {
    "errno": "EINVAL",
    "condition": "args->bo_count == 0",
    "where": "kernel/engine/poulsback_submit.c:poulsback_submit_2d_ioctl",
    "note": "The planner repeats this guard, and its row 'bo_count 0' tests that copy, not this check."
   }
  },
  {
   "id": "submit-2d/bo-count-over-16",
   "parameters": {
    "errno": "EINVAL",
    "condition": "args->bo_count > POULSBACK_2D_MAX_BOS (16)",
    "where": "kernel/engine/poulsback_submit.c:poulsback_submit_2d_ioctl",
    "note": "The planner's redundant guard is tested (row 'bo_count 17'). This one is not."
   }
  },
  {
