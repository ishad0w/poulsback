+/* Extra ownership of an already resident legacy mapping. No page allocation,
+ * PAT/PTE/plane effect or interpretation of an aggregate count as last-fetch. */
+static bool psb_display_pin_same(const struct psb_gem_display_pin *a,
+				 const struct psb_gem_display_pin *b)
+{
+	return a->self == b->self && a->dev == b->dev && a->object == b->object &&
+	       a->parent == b->parent && a->pages == b->pages && a->source == b->source &&
+	       a->source_check == b->source_check &&
+	       a->epoch == b->epoch && a->bytes == b->bytes && a->start == b->start &&
+	       a->end == b->end && a->aperture_start == b->aperture_start &&
+	       a->aperture_end == b->aperture_end && a->stolen_bytes == b->stolen_bytes &&
+	       a->pipe == b->pipe && a->offset == b->offset && a->kind == b->kind &&
+	       a->count == b->count && a->acquired == b->acquired;
+}
+static int psb_display_object(struct drm_device *dev, struct drm_gem_object *object)
+{
+	/* Positive private table and exact device precede every container cast. */
+	if (!dev || !object || object->dev != dev || object->funcs != &psb_gem_object_funcs)
+		return -EXDEV;
+	return IS_PSB(dev) ? 0 : -EOPNOTSUPP;
+}
+static int psb_display_pin_tuple(struct psb_gem_object *p, const struct psb_gem_display_pin *c)
+{
+	struct drm_psb_private *d = to_drm_psb_private(c->dev);
+	struct resource *r = &p->resource, *a = d->gtt_mem;
+	u64 bytes = p->base.size;
+	if (p->poulsback_held || p->poulsback_freeing || p->poulsback_put_after_free)
+		return -EIO;
+	if (!p->in_gart) {
+		return -EOPNOTSUPP;
+	}
+	if (p->in_gart < 0)
+		return -ESTALE;
+	if (!a || a != c->parent || a->start != c->aperture_start || a->end != c->aperture_end ||
+	    a->end < a->start || a->end > U32_MAX || d->gtt.stolen_size != c->stolen_bytes ||
+	    c->stolen_bytes > a->end - a->start + 1 || r->parent != a || r->child || r->flags ||
+	    !bytes || (bytes & (PAGE_SIZE - 1)) || bytes != c->bytes || r->start != c->start ||
+	    r->end != c->end || r->end < r->start || r->end - r->start != bytes - 1 ||
+	    r->start < a->start || r->end > a->end || p->offset != c->offset ||
+	    r->start - a->start != c->offset || p->pages != c->pages ||
+	    c->count != bytes / PAGE_SIZE)
+		return -ESTALE;
+	if (c->kind == PSB_DISPLAY_PIN_STOLEN) {
+		if (!p->stolen || p->pages || p->poulsback_pages_module_ref || !c->stolen_bytes ||
+		    r->end - a->start >= c->stolen_bytes) {
+			return -EOPNOTSUPP;
+		}
+	} else if (c->kind == PSB_DISPLAY_PIN_SYSTEM_PAGES) {
+		if (p->stolen || !p->pages || !p->poulsback_pages_module_ref ||
+		    r->start - a->start < c->stolen_bytes) {
+			return -EOPNOTSUPP;
+		}
+		for (u32 i = 0; i < c->count; i++)
+			if (!c->pages[i])
+				return -ESTALE;
+	} else {
+		return -EOPNOTSUPP;
+	}
+	return 0;
+}
+static int psb_display_pin_current(struct psb_gem_object *p, struct psb_gem_display_pin *pin)
+{
+	u32 i;
+	dma_resv_assert_held(p->base.resv);
+	/* Find the original private owner before trusting mutable token fields. */
+	for (i = 0; i < 2; i++)
+		if (p->poulsback_display_pins[i] == pin)
+			break;
+	if (i == 2 || !pin || pin->self != pin || !pin->acquired ||
+	    pin->pipe != i || !psb_display_pin_same(pin, &p->poulsback_display_pin_original[i]))
+		return -ESTALE;
+	return psb_display_pin_tuple(p, &p->poulsback_display_pin_original[i]);
+}
+static int psb_gem_display_reserved(struct psb_gem_object *p)
+{
+	int n = 0, ret;
+	dma_resv_assert_held(p->base.resv);
+	for (u32 i = 0; i < 2; i++)
+		if (p->poulsback_display_pins[i]) {
+			ret = psb_display_pin_current(p, p->poulsback_display_pins[i]);
+			if (ret)
+				return ret;
+			n++;
+		}
+	return n;
+}
+struct psb_display_pin_action {
+	struct psb_gem_object *object;
+	struct psb_gem_display_pin *pin;
+};
+static int psb_display_pin_acquire_check(void *context)
+{
+	struct psb_display_pin_action *a = context;
+	struct psb_gem_display_pin *c = a->pin;
+	int ret = psb_display_pin_tuple(a->object, c);
+	if (!ret && a->object->in_gart == INT_MAX)
+		ret = -EOVERFLOW;
+	if (!ret && a->object->poulsback_display_pins[c->pipe])
+		ret = -EBUSY;
+	return ret ? ret : c->source_check(c, c->source);
+}
+static void psb_display_pin_acquire_commit(void *context)
+{
+	struct psb_display_pin_action *a = context;
+	struct psb_gem_display_pin *c = a->pin;
+	++a->object->in_gart;
+	c->acquired = true;
+	a->object->poulsback_display_pin_original[c->pipe] = *c;
+	a->object->poulsback_display_pins[c->pipe] = c;
+}
+int psb_gem_display_pin_acquire(struct drm_device *dev, struct drm_gem_object *object, u32 pipe,
+				u64 epoch, struct psb_gem_display_pin *pin,
+				int (*source_check)(const struct psb_gem_display_pin *, void *),
+				void *source)
+{
+	struct psb_display_pin_action action;
+	struct psb_gem_object *p;
+	struct drm_psb_private *d;
+	struct resource *root;
+	int ret, idx;
+	if (!pin || pipe > 1 || !epoch || !source_check || !source ||
+	    memchr_inv(pin, 0, sizeof(*pin)))
+		return -EINVAL;
+	ret = psb_display_object(dev, object);
+	if (ret)
+		return ret;
+	if (!drm_dev_enter(dev, &idx))
+		return -ENODEV;
+	p = to_psb_gem_object(object);
+	d = to_drm_psb_private(dev);
+	ret = sgx535_epoch_external_begin(dev);
+	if (ret)
+		goto exit;
+	ret = dma_resv_lock(object->resv, NULL);
+	if (ret)
+		goto end;
+	root = d->gtt_mem;
+	if (!root) {
+		ret = -ESTALE;
+		goto unlock;
+	}
+	*pin = (struct psb_gem_display_pin){.self = pin,
+					    .dev = dev,
+					    .object = object,
+					    .parent = root,
+					    .pages = p->pages,
+					    .source = source,
+					    .source_check = source_check,
+					    .epoch = epoch,
+					    .bytes = object->size,
+					    .start = p->resource.start,
+					    .end = p->resource.end,
+					    .aperture_start = root->start,
+					    .aperture_end = root->end,
+					    .stolen_bytes = d->gtt.stolen_size,
+					    .pipe = pipe,
+					    .offset = p->offset,
+					    .kind = p->stolen ? PSB_DISPLAY_PIN_STOLEN
+							      : PSB_DISPLAY_PIN_SYSTEM_PAGES,
+					    .count = object->size / PAGE_SIZE};
+	action = (struct psb_display_pin_action){p, pin};
+	ret = sgx535_epoch_external_finalize(dev, epoch, psb_display_pin_acquire_check,
+					     psb_display_pin_acquire_commit, &action);
+	if (ret && !pin->acquired)
+		memset(pin, 0, sizeof(*pin)); /* No count/registry commit took place. */
+unlock:
+	dma_resv_unlock(object->resv);
+end:
+	WARN_ON(sgx535_epoch_external_end(dev));
+exit:
+	drm_dev_exit(idx);
+	return ret;
+}
+int psb_gem_display_pin_lock(struct drm_device *dev, struct drm_gem_object *object,
+			     struct psb_gem_display_pin *pin)
+{
+	int ret = psb_display_object(dev, object);
+	if (ret)
+		return ret;
+	if (!sgx535_epoch_external_active(dev))
+		return -EPERM;
+	ret = dma_resv_lock(object->resv, NULL);
+	if (ret)
+		return ret;
+	ret = psb_display_pin_current(to_psb_gem_object(object), pin);
+	if (ret)
+		dma_resv_unlock(object->resv);
+	return ret;
+}
+void psb_gem_display_pin_unlock(struct drm_gem_object *object)
+{
+	dma_resv_unlock(object->resv);
+}
